# =============================================================================
# ACTIVE BROKER SELECTION ("DHAN" or "ANGEL_ONE")
# =============================================================================
BROKER=DHAN

# =============================================================================
# DHANHQ API CREDENTIALS (PASTE YOUR DHAN DETAILS HERE)
# =============================================================================
# 1. Dhan Client ID (from your Dhan profile, e.g. 1000000000)
DHAN_CLIENT_ID=

# 2. 30-Day Access Token (generated from DhanHQ Portal -> API Access)
DHAN_ACCESS_TOKEN=

# =============================================================================
# ANGEL ONE SMARTAPI CREDENTIALS (ALTERNATIVE BROKER)
# =============================================================================
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# =============================================================================
# EXECUTION & RISK SETTINGS
# =============================================================================
EXECUTION_MODE=PAPER
PAPER_CAPITAL=100000.0

# Contract Selection: "auto" tracks ATM CE and PE of nearest weekly expiry
CONTRACT_MODE=auto
FIXED_STRIKE=0.0
FIXED_OPT_TYPE=CE
FIXED_EXPIRY=

TIMEFRAME_MINUTES=1
LOG_LEVEL=INFO
