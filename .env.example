# =====================================================================
# ANGEL ONE SMARTAPI CREDENTIALS (REQUIRED)
# =====================================================================
# 1. API Key: Create an app at https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_smartapi_api_key_here

# 2. Client Code: Your Angel One trading account User ID (e.g., A123456)
ANGEL_CLIENT_CODE=your_angel_client_code_here

# 3. MPIN: Your 4-digit or 6-digit Angel One login PIN
ANGEL_PIN=your_angel_mpin_here

# 4. TOTP Secret: The 32-character Base32 secret key from Angel One TOTP setup
#    (Generated when enabling TOTP at https://smartapi.angelbroking.com/enable-totp)
ANGEL_TOTP_SECRET=your_32_char_base32_totp_secret_here

# =====================================================================
# SYSTEM & EXECUTION SETTINGS
# =====================================================================
# Default mode on startup is ALWAYS "PAPER". Never starts in "LIVE".
EXECUTION_MODE=PAPER

# Paper trading starting capital override (set 0 or blank to use real account margin)
PAPER_CAPITAL=100000.0

# Strategy contract mode: "auto" (tracks ATM CE & ATM PE) or "fixed"
CONTRACT_MODE=auto

# Fixed contract specification (only used if CONTRACT_MODE=fixed)
# Example: strike 25000, opt_type CE, expiry YYYY-MM-DD
FIXED_STRIKE=0
FIXED_OPT_TYPE=CE
FIXED_EXPIRY=

# Candle timeframe for strategy (1, 3, 5, 10, 15 minutes)
TIMEFRAME_MINUTES=5

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
